# Server Configuration
HOST=127.0.0.1
PORT=3000
FRONTEND_PORT=3001
INTELLIGENCE_PORT=7000
SCRAPLING_PORT=8001
# Blank service URLs are filled from their ports by scripts/*/dev setup.
INTELLIGENCE_URL=
SCRAPLING_URL=
RUST_API_BASE=

# Cross-platform development infrastructure. Use external for your own services.
LOCAL_INFRA=docker
LOCAL_SEARCH=docker
POSTGRES_USER=datavault
POSTGRES_DB=datavault
POSTGRES_PORT=5432
REDIS_PORT=6379
# Setup generates these secrets and connection URLs if blank; preserves existing values.
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=
JWT_SECRET=

# Dynamic Grounding Trigger Threshold (0.0 to 1.0)
GROUNDING_THRESHOLD=0.65

# Hosted LLM providers: only nonempty keys enable catalog discovery/selection.
# Keep real keys in the gitignored root .env; never use NEXT_PUBLIC_* for keys.
GLM_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Optional default models. The picker discovers current models from each provider.
GLM_MODEL=glm-4.5-flash
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
HUGGINGFACE_MODEL=openai/gpt-oss-20b

# Local search stack: docker compose -f compose.search.yml up -d
SEARXNG_URL=http://127.0.0.1:8888
# Host port only; SearXNG listens on 8080 inside its container.
SEARXNG_PORT=8888
# Official images pinned to the versions tested for this checkout.
SEARXNG_IMAGE=docker.io/searxng/searxng@sha256:a07a5cd2da2c63d66e559f9e4d3a3db106cfc6c32fb0ac70abe91cc28bcd7350
SEARXNG_VALKEY_IMAGE=docker.io/valkey/valkey@sha256:48332870af354a799964c0012ae1194a0bf2bf894eb508f945810596dc2d8d11
# Generate a private random secret in .env before starting the search stack.
SEARXNG_SECRET=

# Current Datavault backend + services/intelligence stack.
# Store machine-specific settings and secrets in .env (gitignored).
# .env.llm.local is supported as a legacy fallback; .env takes precedence.
# Local Ollama requires no key, but must be reachable with installed models.
# Hosted processing requires per-collection consent in the picker.
# Laya is disabled pending measured value on a labelled acceptance benchmark.
# Explicit offline evaluation can start the service; production runs keep it off.
LAYA_ENABLED=0
LAYA_URL=http://127.0.0.1:8002
LAYA_PORT=8002
LAYA_MODEL=english
LAYA_RELEVANCE_THRESHOLD=0.20
LAYA_BATCH_SIZE=32

LLM_PROVIDER=local
LLM_FALLBACK_PROVIDER=
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
# Native Ollama structured generation: no thinking, bounded context and output.
LOCAL_LLM_NUM_CTX=8192
LOCAL_LLM_MAX_TOKENS=1024
# Optional comma-separated installed models that fail your structured-output checks.
LOCAL_LLM_DISABLED_MODELS=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
LLM_MAX_CONCURRENCY=1
LLM_TIMEOUT_SECONDS=40
LLM_TOTAL_TIMEOUT_SECONDS=55
LLM_MAX_TOKENS=2048
WORKFLOW_TIMEOUT_SECONDS=180
