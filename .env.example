# Server Configuration
HOST=127.0.0.1
PORT=8080

# Dynamic Grounding Trigger Threshold (0.0 to 1.0)
GROUNDING_THRESHOLD=0.65

# LLM Providers (Provide at least one for generative synthesis, or leave blank for deterministic engine)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Model Name
MODEL_NAME=llama-3.3-70b-versatile

# Optional Meta-Search Engine (SearXNG)
SEARXNG_URL=http://localhost:8080

# Current Datavault backend + services/intelligence stack.
# Store machine-specific settings and secrets in .env.llm.local (gitignored).
# Local is the default. Set nvidia only after approving external processing of
# prompts, field definitions, search queries, and retrieved public web passages.
LLM_PROVIDER=local
LLM_FALLBACK_PROVIDER=
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5-coder:1.5b-instruct
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
LLM_MAX_CONCURRENCY=1
LLM_TIMEOUT_SECONDS=40
LLM_TOTAL_TIMEOUT_SECONDS=55
LLM_MAX_TOKENS=2048
WORKFLOW_TIMEOUT_SECONDS=180
